# Copy to .env.local and replace with unique secrets (32+ characters each).
# Never commit .env.local to version control.

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Local: file relative to prisma/schema.prisma
# Docker: use file:/data/app.db (set automatically in docker-compose.yml)
DATABASE_URL="file:./dev.db"
