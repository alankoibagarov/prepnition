generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  firstName     String
  lastName      String
  passwordHash  String
  role          String       @default("user") // "user" or "admin"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?    // Soft delete support
  sessions      Session[]
  interviews    Interview[]

  @@index([email])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

// Interview model: tracks interviews owned by a single user
enum InterviewStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Interview {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  company     String?
  position    String?
  scheduledAt DateTime?
  status      InterviewStatus @default(PLANNED)
  notes       String?
  score       Int?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([scheduledAt])
  @@index([deletedAt])
}
