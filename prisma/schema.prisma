generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  firstName     String
  lastName      String
  passwordHash  String
  avatarUrl     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?    // Soft delete support
  lastLoginAt   DateTime?    // Last login timestamp
  status        UserStatus   @default(ACTIVE)
  candidateProfile CandidateProfile?

  @@index([email])
  @@index([deletedAt])
}


model CandidateProfile {
  id    String @id @default(cuid())
  userId String @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  interviews    Interview[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Interview model: tracks interviews owned by a single user
enum InterviewStatus {
  CREATED
  APPLICATION
  SCREENING
  TECHNICAL
  MANAGERIAL
  REJECTED
  GHOSTED
  WITHDRAWN
  OFFER
}

model Interview {
  id                String          @id @default(cuid())
  profileId         String
  candidateProfile  CandidateProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title       String
  company     String?
  companyUrl  String?
  position    String?
  scheduledAt DateTime?
  status      InterviewStatus @default(CREATED)
  notes       String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  // Relation to InterviewHistory
  histories    InterviewHistory[]

  @@index([profileId])
  @@index([scheduledAt])
  @@index([deletedAt])
}

model InterviewHistory {
  id          String   @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  action      String
  changes     Json
  createdAt   DateTime @default(now())

  @@index([interviewId])
  @@index([userId])
}
